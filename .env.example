# Copy to .env.local for `vercel dev`, or paste these into Vercel →
# Project → Settings → Environment Variables.

# Required on Vercel: recipe storage (Upstash Redis, free tier is plenty).
# Create a database at https://console.upstash.com → Redis → REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required on Vercel: the AI that reads captions and screenshots.
# Cloudflare deployments can omit this and use the free Workers AI binding.
ANTHROPIC_API_KEY=

# Optional on Vercel: transcribe reels whose recipe is only spoken aloud.
# Cloudflare gets this free via Workers AI; elsewhere point at any
# OpenAI-compatible /audio/transcriptions endpoint.
#   Groq  (default, cheapest): https://console.groq.com  -> gsk_...
#   OpenAI: set WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
#           and WHISPER_MODEL=whisper-1
WHISPER_API_KEY=
# WHISPER_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
# WHISPER_MODEL=whisper-large-v3-turbo

# Optional: "auto" (default), "anthropic", or "workers-ai".
LLM_PROVIDER=auto
