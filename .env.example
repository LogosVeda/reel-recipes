# Copy to .env.local for `vercel dev`, or paste these into Vercel →
# Project → Settings → Environment Variables.

# Required on Vercel: recipe storage (Upstash Redis, free tier is plenty).
# Create a database at https://console.upstash.com → Redis → REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required on Vercel: the AI that reads captions and screenshots.
# Cloudflare deployments can omit this and use the free Workers AI binding.
ANTHROPIC_API_KEY=

# Optional: "auto" (default), "anthropic", or "workers-ai".
LLM_PROVIDER=auto
